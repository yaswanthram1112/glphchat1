rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHandleString(handle) {
      return handle is string && handle.size() >= 3 && handle.size() <= 24 && handle.matches('^[a-z0-9_]+$');
    }

    function isValidPinString(pin) {
      return pin is string && pin.size() == 4 && pin.matches('^[0-9]{4}$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isBoundedStringList(arr, minSize, maxSize) {
      return arr is list &&
        arr.size() >= minSize &&
        arr.size() <= maxSize &&
        (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 128));
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidUserAccount(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 40 &&
        isValidHandleString(data.handle) &&
        isValidPinString(data.pin) &&
        data.online is bool &&
        isValidTimestamp(data.lastSeenAt) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidHandleDirectoryEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        isValidHandleString(data.handle) &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 40 &&
        isValidPinString(data.pin) &&
        data.online is bool &&
        isValidTimestamp(data.lastSeenAt) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidChatRoom(data) {
      return data.chatType in ['DIRECT', 'GROUP'] &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
        isBoundedStringList(data.memberUids, 1, 50) &&
        data.memberLabels is map && data.memberLabels.size() <= 50 &&
        data.lastMessageText is string && data.lastMessageText.size() <= 1000 &&
        data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128 &&
        isValidTimestamp(data.lastMessageAt) &&
        isBoundedStringList(data.readByUids, 0, 50) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidChatMessage(data) {
      return data.chatId is string && isValidId(data.chatId) &&
        data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 40 &&
        data.senderHandle is string && data.senderHandle.size() >= 1 && data.senderHandle.size() <= 30 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
        isBoundedStringList(data.memberUids, 1, 50) &&
        isBoundedStringList(data.readByUids, 1, 50) &&
        data.deleted is bool &&
        (!('replyToMessageId' in data) || (data.replyToMessageId is string && data.replyToMessageId.size() >= 1 && data.replyToMessageId.size() <= 128)) &&
        (!('replyToText' in data) || (data.replyToText is string && data.replyToText.size() >= 1 && data.replyToText.size() <= 200)) &&
        (!('replyToSenderName' in data) || (data.replyToSenderName is string && data.replyToSenderName.size() >= 1 && data.replyToSenderName.size() <= 40)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // --- 1. OWNER-PRIVATE USER ACCOUNTS ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        incoming().userId == request.auth.uid &&
        incoming().keys().hasAll(['userId', 'displayName', 'handle', 'pin', 'online', 'lastSeenAt', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'displayName', 'handle', 'pin', 'online', 'lastSeenAt', 'createdAt', 'updatedAt']) &&
        isValidUserAccount(incoming());

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserAccount(incoming()) &&
        request.auth.uid == userId &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          // Action: Update profile or presence
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'handle', 'pin', 'online', 'lastSeenAt', 'updatedAt']) ||
          // Action: Presence heartbeat only
          incoming().diff(existing()).affectedKeys().hasOnly(['online', 'lastSeenAt', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // --- 2. PUBLIC PII-FREE HANDLE DIRECTORY ---
    match /handles/{handleId} {
      // Exact handle lookup only (no blanket list scraping)
      allow get: if isSignedIn() && isValidHandleString(handleId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidHandleString(handleId) &&
        incoming().userId == request.auth.uid &&
        incoming().handle == handleId &&
        incoming().keys().hasAll(['userId', 'handle', 'displayName', 'pin', 'online', 'lastSeenAt', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'handle', 'displayName', 'pin', 'online', 'lastSeenAt', 'createdAt', 'updatedAt']) &&
        isValidHandleDirectoryEntry(incoming());

      allow update: if isSignedIn() &&
        isValidHandleString(handleId) &&
        isValidHandleDirectoryEntry(incoming()) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().handle == existing().handle &&
        incoming().createdAt == existing().createdAt &&
        (
          // Action: Update display name / pin / presence
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'pin', 'online', 'lastSeenAt', 'updatedAt']) ||
          // Action: Presence heartbeat only
          incoming().diff(existing()).affectedKeys().hasOnly(['online', 'lastSeenAt', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isValidHandleString(handleId) && existing().userId == request.auth.uid;
    }

    // --- 3. CHAT ROOMS (DIRECT & GROUP) ---
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && (
        (resource != null && request.auth.uid in existing().memberUids) ||
        (resource == null && (
          chatId == 'dm_self_' + request.auth.uid ||
          chatId.matches('^dm_' + request.auth.uid + '_[a-zA-Z0-9_\\-]+$') ||
          chatId.matches('^dm_[a-zA-Z0-9_\\-]+_' + request.auth.uid + '$')
        ))
      );
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn() &&
        isValidId(chatId) &&
        incoming().creatorId == request.auth.uid &&
        request.auth.uid in incoming().memberUids &&
        incoming().keys().hasAll([
          'chatType', 'name', 'creatorId', 'memberUids', 'memberLabels',
          'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'readByUids',
          'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'chatType', 'name', 'creatorId', 'memberUids', 'memberLabels',
          'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'readByUids',
          'createdAt', 'updatedAt'
        ]) &&
        isValidChatRoom(incoming());

      allow update: if isSignedIn() &&
        isValidId(chatId) &&
        isValidChatRoom(incoming()) &&
        request.auth.uid in existing().memberUids &&
        incoming().creatorId == existing().creatorId &&
        incoming().chatType == existing().chatType &&
        incoming().createdAt == existing().createdAt &&
        (
          // Action: Update latest message preview and read receipt state
          incoming().diff(existing()).affectedKeys().hasOnly([
            'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'readByUids', 'updatedAt'
          ]) ||
          // Action: Mark chat as read
          incoming().diff(existing()).affectedKeys().hasOnly(['readByUids', 'updatedAt']) ||
          // Action: Group management (creator edits name/members, or member leaves group)
          (
            existing().chatType == 'GROUP' &&
            (existing().creatorId == request.auth.uid || !(request.auth.uid in incoming().memberUids)) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'memberUids', 'memberLabels', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn() && isValidId(chatId) && existing().creatorId == request.auth.uid;

      // --- 4. MESSAGES SUBCOLLECTION ---
      match /messages/{messageId} {
        allow get: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          request.auth.uid in existing().memberUids;

        allow list: if isSignedIn() &&
          request.auth.uid in resource.data.memberUids;

        allow create: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          isValidChatMessage(incoming()) &&
          incoming().chatId == chatId &&
          incoming().senderId == request.auth.uid &&
          incoming().deleted == false &&
          request.auth.uid in incoming().memberUids &&
          request.auth.uid in incoming().readByUids &&
          incoming().keys().hasAll([
            'chatId', 'senderId', 'senderName', 'senderHandle', 'text',
            'memberUids', 'readByUids', 'deleted', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'chatId', 'senderId', 'senderName', 'senderHandle', 'text',
            'memberUids', 'readByUids', 'deleted',
            'replyToMessageId', 'replyToText', 'replyToSenderName',
            'createdAt', 'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/chats/$(chatId)) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids &&
          incoming().memberUids == get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids;

        allow update: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          isValidChatMessage(incoming()) &&
          request.auth.uid in existing().memberUids &&
          incoming().chatId == existing().chatId &&
          incoming().senderId == existing().senderId &&
          incoming().memberUids == existing().memberUids &&
          incoming().createdAt == existing().createdAt &&
          (
            // Action: Mark message as read by a chat member
            incoming().diff(existing()).affectedKeys().hasOnly(['readByUids', 'updatedAt']) ||
            // Action: Soft-delete by original sender
            (
              existing().senderId == request.auth.uid &&
              incoming().deleted == true &&
              incoming().diff(existing()).affectedKeys().hasOnly(['deleted', 'text', 'updatedAt'])
            )
          );

        allow delete: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          existing().senderId == request.auth.uid;
      }
    }
  }
}
